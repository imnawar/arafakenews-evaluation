# Copy this file to .streamlit/secrets.toml (same folder structure, this
# exact filename) and fill in your real values. NEVER commit the real
# secrets.toml to GitHub — add ".streamlit/secrets.toml" to .gitignore.
#
# On Streamlit Community Cloud, you don't need this file at all: instead,
# go to your app -> Settings -> Secrets, and paste the same two lines there.

SUPABASE_URL = "https://YOUR-PROJECT-ID.supabase.co"
SUPABASE_KEY = "YOUR-ANON-PUBLIC-KEY"
